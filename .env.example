# Copy to .env in the repo root, and to apps/api/.env, apps/web/.env.local, apps/admin/.env.local as needed.

# ---- Database ----
DATABASE_URL="postgresql://rabindhakal@localhost:5432/ecommerce_x_dev?schema=public"

# ---- API ----
PORT=4100
NODE_ENV=development
API_URL=http://localhost:4100
WEB_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Used to AES-256-GCM encrypt payment gateway secrets stored in the Setting table
SETTINGS_ENCRYPTION_KEY=change-me-32-byte-base64-key-000000000000

# Local file storage
UPLOAD_DIR=./uploads

# ---- Payment Gateways (sandbox defaults; real values are entered in Admin > Settings > Payments
#      and override these at runtime — these env vars are only the fallback/dev bootstrap) ----

# eSewa ePay v2 (UAT/sandbox)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_ENV=sandbox

# Fonepay
FONEPAY_MERCHANT_CODE=your-fonepay-merchant-code
FONEPAY_SECRET_KEY=your-fonepay-secret-key
FONEPAY_ENV=sandbox

# NIC Asia via CyberSource Secure Acceptance
CYBERSOURCE_PROFILE_ID=your-profile-id
CYBERSOURCE_ACCESS_KEY=your-access-key
CYBERSOURCE_SECRET_KEY=your-secret-key
CYBERSOURCE_ENV=sandbox

# ---- Frontend public env (web & admin) ----
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_SITE_NAME="Fashion & Cosmetics Store"
